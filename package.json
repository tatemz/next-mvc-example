{
  "name": "next-mvc-example",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "description": "Next.js App Router example with Effect v4: one dossier UI served from SWAPI or the Ghibli API through a shared PeopleCatalog port.",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "next build",
    "test:e2e": "NODE_OPTIONS=\"--import tsx\" effect-bdd --features \"features/**/*.feature\" --steps \"features/**/*.steps.ts\" --reporter text --parallel=2 --strict --step-timeout \"60 seconds\"",
    "pretest:e2e:debug": "next build",
    "test:e2e:debug": "E2E_DEBUG=1 NODE_OPTIONS=\"--import tsx\" effect-bdd --features \"features/**/*.feature\" --steps \"features/**/*.steps.ts\" --reporter text --parallel=1 --verbose --strict --step-timeout \"60 seconds\""
  },
  "dependencies": {
    "@formatjs/intl": "^3.1.8",
    "@fuiste/optics": "^1.0.1",
    "@typesafe-intl/core": "^0.0.7",
    "effect": "4.1.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@usestrider/browser": "0.14.0",
    "@vitest/coverage-v8": "5.1.1",
    "daisyui": "^5.8.2",
    "effect-bdd": "0.12.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
