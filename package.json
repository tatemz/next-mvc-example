{
  "name": "next-mvc-example",
  "version": "0.1.0",
  "description": "Next.js App Router MVC example with Effect v4, a Star Wars API client, and a server-action form.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "next build",
    "test:e2e": "NODE_OPTIONS=\"--import tsx\" effect-bdd --features \"features/**/*.feature\" --steps \"features/**/*.steps.ts\" --reporter text --strict --step-timeout \"60 seconds\""
  },
  "dependencies": {
    "effect": "4.1.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@usestrider/browser": "0.14.0",
    "@vitest/coverage-v8": "5.1.1",
    "effect-bdd": "0.12.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
