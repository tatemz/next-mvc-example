{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json"
  ],
  "ignorePatterns": [
    ".next/**",
    ".openchamber/**",
    "artifacts/**",
    "coverage/**",
    "storybook-static/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.{ts,tsx}",
        "features/**/*.ts",
        "src/**/*.stories.tsx"
      ],
      "rules": {
        "effecttsgo/unstable-api-usage": "off"
      }
    },
    {
      "files": [
        "src/api/**",
        "src/server/**",
        "src/services/**",
        "server.ts"
      ],
      "rules": {
        "effecttsgo/unstable-api-usage": "off"
      }
    }
  ]
}
